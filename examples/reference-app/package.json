{
  "name": "@sveltex/example-reference-app",
  "version": "0.1.0",
  "private": true,
  "description": "Stage 3 reference application: persistence, validation, authentication, authorization, sessions, and caching wired together from real @sveltex packages",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs && tsc -p tests/types/tsconfig.json",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json"
  },
  "dependencies": {
    "@sveltex/auth": "workspace:*",
    "@sveltex/cache": "workspace:*",
    "@sveltex/database": "workspace:*",
    "@sveltex/session": "workspace:*",
    "@sveltex/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "engines": {
    "node": ">=20.11"
  }
}
