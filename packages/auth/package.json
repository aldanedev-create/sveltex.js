{
  "name": "@sveltex/auth",
  "version": "0.1.0",
  "description": "Credential authentication service contracts and secure session integration points for SvelteX",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./argon2": {
      "types": "./dist/argon2.d.ts",
      "import": "./dist/argon2.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./limiter": {
      "types": "./dist/limiter.d.ts",
      "import": "./dist/limiter.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./rbac": {
      "types": "./dist/rbac.d.ts",
      "import": "./dist/rbac.js"
    },
    "./reset": {
      "types": "./dist/reset.d.ts",
      "import": "./dist/reset.js"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "import": "./dist/verification.js"
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs && tsc -p tests/types/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "test:unit": "npm test",
    "test:security": "npm run build && node --test tests/security/*.test.mjs",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json",
    "test:coverage": "npm run build && node --experimental-test-coverage --test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@sveltex/shared": "workspace:*"
  },
  "keywords": [
    "sveltex",
    "authentication",
    "credentials",
    "sessions"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
