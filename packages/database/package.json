{
  "name": "@sveltex/database",
  "version": "0.1.0",
  "description": "Driver-neutral database lifecycle, pooled PostgreSQL/MySQL/SQLite adapters, and ordered migrations for SvelteX",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./mysql": {
      "types": "./dist/mysql.d.ts",
      "import": "./dist/mysql.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs && tsc -p tests/types/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "test:unit": "npm test",
    "test:security": "npm run build && node --test tests/security/*.test.mjs",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json",
    "test:integration": "npm run build && node --test tests/postgres-integration.test.mjs tests/mysql-integration.test.mjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sveltex",
    "database",
    "transactions",
    "sql",
    "postgresql",
    "mysql",
    "sqlite",
    "migrations",
    "connection-pool"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  }
}
