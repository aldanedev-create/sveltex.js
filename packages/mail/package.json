{
  "name": "@sveltex/mail",
  "version": "0.1.0",
  "description": "Email message contracts, attachments, real SMTP/HTTP provider adapters, MIME serialization, templates, retries, and a deterministic test transport",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-transport": {
      "types": "./dist/test-transport.d.ts",
      "import": "./dist/test-transport.js"
    },
    "./mime": {
      "types": "./dist/mime.d.ts",
      "import": "./dist/mime.js"
    },
    "./smtp": {
      "types": "./dist/smtp.d.ts",
      "import": "./dist/smtp.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs tests/security/*.test.mjs && tsc -p tests/types/tsconfig.json",
    "test:unit": "npm test",
    "test:security": "npm run build && node --test tests/security/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json",
    "test:coverage": "npm run build && node --experimental-test-coverage --test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sveltex",
    "mail",
    "email",
    "smtp",
    "mime",
    "attachments",
    "templates",
    "transport"
  ],
  "dependencies": {
    "@sveltex/shared": "workspace:*",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@sveltex/auth": "workspace:*",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^7.0.12",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.14.3",
    "smtp-server": "^3.21.4"
  }
}
