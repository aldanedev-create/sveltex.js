{
  "name": "@sveltex/realtime",
  "version": "0.1.0",
  "description": "Typed realtime channels with authorization hooks, transport contracts, and an in-process transport",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./in-process": {
      "types": "./dist/in-process.d.ts",
      "import": "./dist/in-process.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "import": "./dist/connection.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "import": "./dist/sse.js"
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs tests/security/*.test.mjs && tsc -p tests/types/tsconfig.json",
    "test:unit": "npm test",
    "test:security": "npm run build && node --test tests/security/*.test.mjs",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json",
    "test:coverage": "npm run build && node --experimental-test-coverage --test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sveltex",
    "realtime",
    "pubsub",
    "channels",
    "websocket"
  ],
  "dependencies": {
    "@sveltex/shared": "workspace:*",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2"
  }
}
