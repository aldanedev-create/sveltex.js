{
  "name": "@sveltex/session",
  "version": "0.1.0",
  "description": "Session lifecycle and storage contracts with an in-memory development store",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    },
    "./cookie": {
      "types": "./dist/cookie.d.ts",
      "import": "./dist/cookie.js"
    },
    "./csrf": {
      "types": "./dist/csrf.d.ts",
      "import": "./dist/csrf.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs tests/security/*.test.mjs && tsc -p tests/types/tsconfig.json",
    "test:unit": "npm test",
    "test:security": "npm run build && node --test tests/security/*.test.mjs",
    "test:types": "npm run build && tsc -p tests/types/tsconfig.json",
    "test:coverage": "npm run build && node --experimental-test-coverage --test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sveltex/shared": "workspace:*",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@sveltex/auth": "workspace:*",
    "@sveltex/database": "workspace:*",
    "@types/node": "^26.6.6"
  }
}
